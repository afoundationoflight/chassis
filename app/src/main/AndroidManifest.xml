<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- THE ONLY PERMISSION. Nothing leaves the device except a search
         or an api call the seat explicitly wills. The chassis, the
         stores, the room and the runtimes are all in here. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name="com.chaquo.python.android.PyApplication"
        android:label="Chassis"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
        android:supportsRtl="true">
        <activity
            android:name=".PyActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />
        <!-- NOTE: this .SettingsActivity entry currently has no
             matching class in app/src/main — it points at
             legacy/kotlin-chassis/SettingsActivity.kt, which is not
             built into this app module. Left as-is; not this task's to
             fix. GeneratorSettingsActivity below is the new, real one. -->
        <activity
            android:name=".GeneratorSettingsActivity"
            android:exported="false"
            android:label="generator" />
    </application>
</manifest>
